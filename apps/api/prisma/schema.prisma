generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  USER
  ANCHOR
  REVIEWER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum ContentStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  OFFLINE
}

enum ContentKind {
  DYNAMIC
  CIRCLE_DYNAMIC
  MATERIAL
}

enum LiveStatus {
  CREATED
  LIVE
  RECONNECTING
  ENDED
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum ReportStatus {
  SUBMITTED
  PROCESSING
  RESOLVED
  REJECTED
}

enum ApplicationType {
  ACCOUNT_MERGE
  JOIN_US
}

enum ApplicationStatus {
  SUBMITTED
  PROCESSING
  APPROVED
  REJECTED
}

enum ProductType {
  COIN_PACKAGE
  MEMBERSHIP
  GOODS
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDING
  REFUNDED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CALLING
  COMPLETED
  CANCELLED
}

model User {
  id              String        @id @default(cuid())
  username        String        @unique
  displayName     String
  passwordHash    String
  status          AccountStatus @default(ACTIVE)
  avatarUrl       String?
  bio             String?
  failedLoginCount Int          @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  roles           UserRole[]
  wallet          Wallet?
  circles         Circle[]      @relation("CircleOwner")
  posts           Post[]
  liveRooms       LiveRoom[]
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]    @relation("AuditActor")
  devices         Device[]
  reports         Report[]
  applications    Application[]
  favorites       Favorite[]
  comments        Comment[]
  addresses       Address[]
  orders          Order[]
  memberships     Membership[]
  appointmentsMade Appointment[] @relation("AppointmentUser")
  appointmentsReceived Appointment[] @relation("AppointmentAnchor")
  chatSetting     ChatSetting?
}

model Product {
  id         String      @id @default(cuid())
  name       String
  type       ProductType
  price      Int
  coinAmount Int?
  planDays   Int?
  stock      Int?
  active     Boolean     @default(true)
  orders     Order[]
  memberships Membership[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model MembershipPlan {
  id       String   @id @default(cuid())
  name     String
  days     Int
  price    Int
  benefits String[]
  active   Boolean  @default(true)
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  productId String
  active    Boolean  @default(true)
  startsAt  DateTime
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
  @@unique([userId, productId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  recipient String
  phone     String
  detail    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  productId      String
  quantity       Int
  totalAmount    Int
  status         OrderStatus @default(PENDING)
  idempotencyKey String      @unique
  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  product        Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  paymentEvents  PaymentEvent[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model PaymentEvent {
  id        String   @id @default(cuid())
  orderId   String
  eventId   String   @unique
  success   Boolean
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Application {
  id        String            @id @default(cuid())
  userId    String
  type      ApplicationType
  status    ApplicationStatus @default(SUBMITTED)
  payload   Json
  remark    String?
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model Device {
  id          String   @id @default(cuid())
  userId      String
  fingerprint String   @unique
  name        String
  lastSeenAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  targetType String
  targetId   String
  reason     String
  status     ReportStatus @default(SUBMITTED)
  resolution String?
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model Role {
  id          String     @id @default(cuid())
  code        RoleCode   @unique
  name        String
  permissions String[]
  users       UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Wallet {
  id        String        @id @default(cuid())
  userId    String        @unique
  balance   Int           @default(0)
  version   Int           @default(0)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   LedgerEntry[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model LedgerEntry {
  id             String          @id @default(cuid())
  walletId       String
  direction      LedgerDirection
  amount         Int
  balanceAfter   Int
  reason         String
  idempotencyKey String          @unique
  wallet         Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  createdAt      DateTime        @default(now())
}

model Circle {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  entryCoins  Int      @default(0)
  ownerId     String
  owner       User     @relation("CircleOwner", fields: [ownerId], references: [id])
  posts       Post[]
  invites     CircleInvite[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Post {
  id        String        @id @default(cuid())
  authorId  String
  circleId  String?
  title     String
  body      String
  kind      ContentKind   @default(DYNAMIC)
  tags      String[]
  status    ContentStatus @default(DRAFT)
  rejectionReason String?
  author    User          @relation(fields: [authorId], references: [id])
  circle    Circle?       @relation(fields: [circleId], references: [id])
  favorites Favorite[]
  comments  Comment[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model CircleInvite {
  id        String   @id @default(cuid())
  circleId  String
  code      String   @unique
  expiresAt DateTime?
  maxUses   Int?
  uses      Int      @default(0)
  circle    Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Favorite {
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, postId])
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  body      String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime  @default(now())
}

model LiveRoom {
  id              String     @id @default(cuid())
  anchorId        String
  title           String
  status          LiveStatus @default(CREATED)
  viewerCoins     Int        @default(0)
  secondViewCoins Int        @default(0)
  streamKey       String     @unique
  publishUrl      String?
  playbackUrl     String     @default("")
  anchor          User       @relation(fields: [anchorId], references: [id])
  invites         LiveInvite[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model LiveInvite {
  id        String   @id @default(cuid())
  roomId    String
  code      String   @unique
  type      String
  room      LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Appointment {
  id          String            @id @default(cuid())
  userId      String
  anchorId    String
  scheduledAt DateTime
  note        String?
  status      AppointmentStatus @default(PENDING)
  user        User              @relation("AppointmentUser", fields: [userId], references: [id], onDelete: Cascade)
  anchor      User              @relation("AppointmentAnchor", fields: [anchorId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model ChatSetting {
  userId        String  @id
  allowMessages Boolean @default(true)
  greeting      String  @default("")
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
